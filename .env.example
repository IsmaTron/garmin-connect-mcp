# --- Obligatorias ---

# Credenciales de tu cuenta de Garmin Connect
GARMIN_EMAIL=you@email.com
GARMIN_PASSWORD=yourpassword

# --- Recomendadas en Railway ---

# Token Bearer que protege el endpoint /mcp (genera uno con: openssl rand -hex 32)
# Si no se define, el endpoint queda abierto a cualquiera que conozca la URL
MCP_AUTH_TOKEN=

# 'http' para Railway (ya viene puesto en el Dockerfile), 'stdio' para uso local
MCP_TRANSPORT=http

# --- Opcionales (descomenta solo las que uses) ---

# Puerto de escucha (por defecto 3000). Railway inyecta PORT automaticamente: NO la definas alli
# PORT=3000

# Directorio donde se persisten los tokens OAuth (util con un volumen de Railway montado en /data)
# Por defecto: ~/.garmin-mcp
# GARMIN_TOKEN_DIR=/data/garmin-mcp

# Siembra de tokens para cuentas con MFA: contenido JSON de los ficheros
# generados por "npm run setup" en tu maquina local.
# Tienen prioridad sobre los ficheros cacheados en GARMIN_TOKEN_DIR
# GARMIN_OAUTH1_TOKEN=contenido de ~/.garmin-mcp/oauth1_token.json
# GARMIN_OAUTH2_TOKEN=contenido de ~/.garmin-mcp/oauth2_token.json

# Alternativa a lo anterior: codigo MFA de un solo uso para el primer login
# (caduca en minutos; los tokens sembrados son la opcion fiable)
# GARMIN_MFA_CODE=123456
